# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=https://grabchatai.com

# Dodo Payments — Dashboard → Developer → API Keys
# Test keys start with dodo_test_, live keys with dodo_live_. Each only works in its own mode.
DODO_PAYMENTS_API_KEY=dodo_test_xxx
DODO_PAYMENTS_ENVIRONMENT=test_mode          # test_mode | live_mode
DODO_PAYMENTS_RETURN_URL=https://grabchatai.com/checkout/success

# Dashboard → Developer → Webhooks (endpoint: https://grabchatai.com/api/webhooks/dodo)
DODO_PAYMENTS_WEBHOOK_KEY=whsec_xxx

# Product IDs from Dashboard → Products (create one per plan, prices must match src/lib/site.ts)
DODO_PRODUCT_PRO_MONTHLY=pdt_xxx
DODO_PRODUCT_PRO_YEARLY=pdt_xxx

# Google sign-in — Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://grabchatai.com/api/auth/google/callback
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32+-character-string
